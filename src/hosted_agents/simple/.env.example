# Local runs only. In Foundry the platform injects FOUNDRY_PROJECT_ENDPOINT
# and azure.yaml supplies the rest. Never bake .env into the image.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
TOOLBOX_NAME=demo-tools
MEMORY_STORE_NAME=demo-memory
LOCAL_USER_ID=local-dev
