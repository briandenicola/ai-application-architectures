{
  "name": "banking-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing a UI-enabled tool (MCP Apps) for the MAF + AG-UI sample",
  "scripts": {
    "test": "tsx --test functions/*.test.ts",
    "build:ui": "vite build",
    "build": "npm run build:ui",
    "start": "npm run build:ui && tsx main.ts",
    "dev": "concurrently --raw \"vite build --watch\" \"tsx watch main.ts\""
  },
  "dependencies": {
    "@azure/functions": "^4.7.2",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.29.1",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
