{
  "name": "mcp-apps-host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal AG-UI host: BFF with MCPAppsMiddleware in front of a MAF agent, plus a browser page that renders MCP Apps",
