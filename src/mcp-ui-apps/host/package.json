    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  },
  "main": "index.js",
