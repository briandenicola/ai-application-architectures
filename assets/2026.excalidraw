"fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "ah", "roundness": {"type": 2}, "seed": 144, "version": 1, "versionNonce": 144, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [-60, 88]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "el145", "type": "rectangle", "x": 940, "y": 550, "width": 640, "height": 240, "angle": 0, "strokeColor": "#862e9c", "backgroundColor": "#f8f0fc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "ai", "roundness": {"type": 3}, "seed": 145, "version": 1, "versionNonce": 145, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "el146", "type": "text", "x": 1075, "y": 590.0, "width": 495, "height": 160.0, "angle": 0, "strokeColor": "#862e9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "aj", "roundness": null, "seed": 146, "version": 1, "versionNonce": 146, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "IN-HOUSE SUBAGENTS\nWho in my own house thinks this through?\n\nConsigliere: plan it, limit legal exposure\nSuccessor: should we do this favor at all?\n\nSame runtime, same trust boundary.\nNot exposed outside the family, so not A2A.", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "IN-HOUSE SUBAGENTS\nWho in my own house thinks this through?\n\nConsigliere: plan it, limit legal exposure\nSuccessor: should we do this favor at all?\n\nSame runtime, same trust boundary.\nNot exposed outside the family, so not A2A.", "autoResize": false, "lineHeight": 1.25}, {"id": "el147", "type": "image", "x": 952, "y": 562, "width": 115, "height": 125.18987341772151, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "ak", "roundness": null, "seed": 147, "version": 1, "versionNonce": 147, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "status": "saved", "fileId": "img_cons", "scale": [1, 1], "crop": null}, {"id": "el148", "type": "image", "x": 952, "y": 694, "width": 115, "height": 87.06214689265536, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "al", "roundness": null, "seed": 148, "version": 1, "versionNonce": 148, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "status": "saved", "fileId": "img_succ", "scale": [1, 1], "crop": null}, {"id": "el149", "type": "arrow", "x": 1100, "y": 480, "width": 30, "height": 68, "angle": 0, "strokeColor": "#862e9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "am", "roundness": {"type": 2}, "seed": 149, "version": 1, "versionNonce": 149, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [30, 68]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "el150", "type": "text", "x": 1140, "y": 495, "width": 200, "height": 16.25, "angle": 0, "strokeColor": "#862e9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "an", "roundness": null, "seed": 150, "version": 1, "versionNonce": 150, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "In-process call", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "In-process call", "autoResize": false, "lineHeight": 1.25}, {"id": "el151", "type": "rectangle", "x": 60, "y": 830, "width": 800, "height": 220, "angle": 0, "strokeColor": "#862e9c", "backgroundColor": "#f8f0fc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "ao", "roundness": {"type": 3}, "seed": 151, "version": 1, "versionNonce": 151, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "el152", "type": "text", "x": 84, "y": 855.0, "width": 752, "height": 170.0, "angle": 0, "strokeColor": "#862e9c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "ap", "roundness": null, "seed": 152, "version": 1, "versionNonce": 152, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "2026 DECISION KEY\n\nSKILL → How do we do it? (the playbook)\nMCP → What capability can I use? (the toolbox)\nSUBAGENT → Who in my house helps me think? (shared runtime)\nA2A → Who do I delegate it to? (independent boundary)\n\nA2A needs no shared runtime, memory, tools, or framework.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2026 DECISION KEY\n\nSKILL → How do we do it? (the playbook)\nMCP → What capability can I use? (the toolbox)\nSUBAGENT → Who in my house helps me think? (shared runtime)\nA2A → Who do I delegate it to? (independent boundary)\n\nA2A needs no shared runtime, memory, tools, or framework.", "autoResize": false, "lineHeight": 1.25}, {"id": "el153", "type": "rectangle", "x": 900, "y": 830, "width": 1390, "height": 220, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "aq", "roundness": {"type": 3}, "seed": 153, "version": 1, "versionNonce": 153, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "el154", "type": "text", "x": 924, "y": 870.0, "width": 1342, "height": 140.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "ar", "roundness": null, "seed": 154, "version": 1, "versionNonce": 154, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "WHAT CHANGED FROM THE 2025 VERSION\n\n1. Not every arrow is A2A. Consigliere and Successor are in-house subagents.\n2. MCP is capability access. It is not shared context or turn-based conversation.\n3. Skills are new: procedure lives in the playbook, loaded on demand, not in every prompt.\n4. The Enforcer moved behind the Capo's boundary. The Don delegates the objective and never sees him.\n5. A2A is a task with a lifecycle and a result, discovered through an Agent Card.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "WHAT CHANGED FROM THE 2025 VERSION\n\n1. Not every arrow is A2A. Consigliere and Successor are in-house subagents.\n2. MCP is capability access. It is not shared context or turn-based conversation.\n3. Skills are new: procedure lives in the playbook, loaded on demand, not in every prompt.\n4. The Enforcer moved behind the Capo's boundary. The Don delegates the objective and never sees him.\n5. A2A is a task with a lifecycle and a result, discovered through an Agent Card.", "autoResize": false, "lineHeight": 1.25}, {"id": "el155", "type": "text", "x": 40, "y": 1080, "width": 2250, "height": 47.5, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "as", "roundness": null, "seed": 155, "version": 1, "versionNonce": 155, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Just because something is implemented as an agent does not mean it needs to be exposed as an agent.\nUse A2A when another independently managed agent owns the delegated work.", "fontSize": 19, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Just because something is implemented as an agent does not mean it needs to be exposed as an agent.\nUse A2A when another independently managed agent owns the delegated work.", "autoResize": false, "lineHeight": 1.25}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {"img_scene": {"mimeType": "image/png", "id": "img_scene", "dataURL": "data:image/png;base64,", "created": 1, "lastRetrieved": 1}, "img_don": {"mimeType": "image/png", "id": "img_don", "dataURL": "data:image/png;base64,", "created": 1, "lastRetrieved": 1}, "img_capo": {"mimeType": "image/png", "id": "img_capo", "dataURL": "data:image/png;base64,", "created": 1, "lastRetrieved": 1}, "img_cons": {"mimeType": "image/png", "id": "img_cons", "dataURL": "data:image/png;base64,", "created": 1, "lastRetrieved": 1}, "img_succ": {"mimeType": "image/png", "id": "img_succ", "dataURL": "data:image/png;base64,", "created": 1, "lastRetrieved": 1}, "img_enf": {"mimeType": "image/png", "id": "img_enf", "dataURL": "data:image/png;base64,", "created": 1, "lastRetrieved": 1}, "img_brain": {"mimeType": "image/png", "id": "img_brain", "dataURL": "da