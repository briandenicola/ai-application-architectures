      "seed": 2120894311,
      "version": 1,
      "versionNonce": 986531893,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784754174278,
      "link": null,
      "locked": false,
      "text": "# 1) Install KubeAI\nhelm repo add kubeai https://www.kubeai.org\nhelm install kubeai kubeai/kubeai --wait\n\n# 2) Deploy a model: kubectl apply -f model.yaml\napiVersion: kubeai.org/v1\nkind: Model\nmetadata:\n  name: qwen2.5-7b\nspec:\n  url: hf://Qwen/Qwen2.5-7B-Instruct\n  engine: VLLM\n  resourceProfile: nvidia-gpu-l40:1\n  minReplicas: 1",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 188.5,
      "containerId": null,
      "originalText": "# 1) Install KubeAI\nhelm repo add kubeai https://www.kubeai.org\nhelm install kubeai kubeai/kubeai --wait\n\n# 2) Deploy a model: kubectl apply -f model.yaml\napiVersion: kubeai.org/v1\nkind: Model\nmetadata:\n  name: qwen2.5-7b\nspec:\n  url: hf://Qwen/Qwen2.5-7B-Instruct\n  engine: VLLM\n  resourceProfile: nvidia-gpu-l40:1\n  minReplicas: 1",
      "lineHeight": 1.25
    },
