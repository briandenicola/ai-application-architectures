  {
   "id": "notes_t",
   "type": "text",
   "x": 765.72,
   "y": 921.25,
   "width": 658.5600000000001,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 649821630,
   "version": 1,
   "versionNonce": 996247159,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Workflow state is the source of truth; each hosted-agent turn is one activity.\nUse background mode: store the response ID first, then poll on a durable timer.\nPass the end user's isolation key, or every session belongs to the harness identity.\nNo Durable Task Scheduler and no Azure Functions in this layout.\nVerify: private access to the hosted agent endpoint, and the Dapr version on AKS.",
   "originalText": "Workflow state is the source of truth; each hosted-agent turn is one activity.\nUse background mode: store the response ID first, then poll on a durable timer.\nPass the end user's isolation key, or every session belongs to the harness identity.\nNo Durable Task Scheduler and no Azure Functions in this layout.\nVerify: private access to the hosted agent endpoint, and the Dapr version on AKS.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "notes",
   "lineHeight": 1.25,
   "autoResize": true
  },
