    {
      "id": "ISF7dY2jIrd1BIYLxPZkj",
      "type": "text",
      "x": 2112.200452012065,
      "y": 433.0103872995733,
      "width": 685.3317260742188,
      "height": 720,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5Z",
      "roundness": null,
      "seed": 134641132,
      "version": 1501,
      "versionNonce": 1043181433,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761570583481,
      "link": null,
      "locked": false,
      "text": "Workflow \n* Handling request through a multi-agent \nagentic system \n\nMCP \n* Tool Discovery and Registration \n* Agent share context\n* Turned base conversation\n\nA2A\n* Invocate agent using common format\n* Used to orchestrate multiple agents \n   across boundaries\n* No shared context\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workflow \n* Handling request through a multi-agent \nagentic system \n\nMCP \n* Tool Discovery and Registration \n* Agent share context\n* Turned base conversation\n\nA2A\n* Invocate agent using common format\n* Used to orchestrate multiple agents \n   across boundaries\n* No shared context\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
